# Software Information
display_name = "Microsoft - Xbox (xemu)"
authors = "xemu team"
supported_extensions = "iso|xiso"
corename = "xemu"
manufacturer = "Microsoft"
categories = "Emulator"
systemname = "Microsoft Xbox"
systemid = "xbox"
license = "GPLv2"
permissions = ""
# The core's own release line. It deliberately does not name an upstream xemu
# version: this file is static while the core reports a git-derived string from
# retro_get_system_info (e.g. 0.1.0-emuvr-rc1-58-g...), and the two silently
# disagreeing is worse than one of them being coarse. Check the log line at
# load for the exact build.
display_version = "0.1.0-emuvr"
supports_no_game = "false"

# Hardware Information
database = "Microsoft - Xbox"

# Libretro Features
savestate = "true"
savestate_features = "basic"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "2.0"
load_subsystem = "false"
hw_render = "true"
needs_fullpath = "true"
disk_control = "false"
is_experimental = "true"

# Firmware / system files (system/xemu/)
# The BIOS may be either Complex_4627.bin or the debug Complex_4627v1.03.bin;
# the core accepts whichever is present. RetroArch lists each firmware entry
# independently, so both names appear - only one is needed.
firmware_count = 4
firmware0_desc = "mcpx_1.0.bin (MCPX v1.0 Boot ROM, required - md5 d49c52a4102f6df7bcf8d0617ac475ed)"
firmware0_path = "xemu/mcpx_1.0.bin"
firmware0_opt = "false"
firmware1_desc = "Complex_4627.bin (Xbox flash BIOS, required - or use Complex_4627v1.03.bin instead)"
firmware1_path = "xemu/Complex_4627.bin"
firmware1_opt = "false"
firmware2_desc = "Complex_4627v1.03.bin (debug Xbox flash BIOS, optional alternative - md5 21445c6f28fca7285b0f167ea770d1e5)"
firmware2_path = "xemu/Complex_4627v1.03.bin"
firmware2_opt = "true"
firmware3_desc = "xbox_hdd.qcow2 (Xbox HDD image, required - xemu team's copyright-free or a retail image)"
firmware3_path = "xemu/xbox_hdd.qcow2"
firmware3_opt = "false"

notes = "(!) System files go in the RetroArch system/xemu/ directory.|BIOS: Complex_4627.bin OR the debug Complex_4627v1.03.bin (either works).|The core logs each system file's md5 at load and warns if a BIOS/boot ROM is unrecognized.|A missing xbox_eeprom.bin is generated on first run.|Content must be xiso format; convert other dumps with extract-xiso.|Save states restore full machine state but do not support rewind, run-ahead or netplay.|(Controller) A standard Xbox 360/One pad maps 1:1 with no remapping needed; the Xbox's Black and White buttons sit on RB and LB.|(Controller) EmuVR forces input_player1_analog_dpad_mode = \"1\" on all cores, which doubles the left stick onto the d-pad for player 1. The bundled config/xemu/xemu.cfg pins it back off for this core; if you installed the core without that file, add input_player1_analog_dpad_mode = \"0\" (and player2..4) there yourself. A core has no API to change this - it is a frontend input setting.|(Faster) The same config file sets video_driver = \"vulkan\". This is a RetroArch setting for how the frontend presents frames - it is NOT the core's Renderer option and the two are unrelated. It helps by removing GL contention with the emulator's own contexts; comment it out if the EmuVR VR view goes black.|Save states are specific to the renderer that wrote them. Loading a state made under the other Renderer setting is refused with a message rather than restored into a machine that cannot represent it."
